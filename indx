<audio id="bgm" src="music.mp4" preload="auto" loop></audio>

<script>
// ---------- Countdown Code ----------
const eventDate = new Date(2026, 10, 20, 19, 0, 0).getTime();

function updateCountdown() {
  const now = new Date().getTime();
  const diff = eventDate - now;

  if (diff > 0) {
    document.getElementById('cdD').innerText = Math.floor(diff / (1000 * 60 * 60 * 24));
    document.getElementById('cdH').innerText = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    document.getElementById('cdM').innerText = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    document.getElementById('cdS').innerText = Math.floor((diff % (1000 * 60)) / 1000);
  }
}
setInterval(updateCountdown, 1000);
updateCountdown();

// ---------- Envelope & Music Interaction ----------
const gate = document.getElementById('gate');
const openBtn = document.getElementById('openBtn');
const seal = document.getElementById('seal');
const bgm = document.getElementById('bgm');
const musicCtrl = document.getElementById('music');
const mPlay = document.getElementById('mPlay');

function openEnvelope() {
  gate.classList.add('opening');
  setTimeout(() => {
    gate.classList.add('leaving');
    document.body.classList.add('revealed');
    musicCtrl.removeAttribute('hidden');
    bgm.play().catch(() => {});
    musicCtrl.classList.add('playing');
  }, 1200);
}

openBtn.addEventListener('click', openEnvelope);
seal.addEventListener('click', openEnvelope);

mPlay.addEventListener('click', () => {
  if (bgm.paused) {
    bgm.play();
    musicCtrl.classList.add('playing');
  } else {
    bgm.pause();
    musicCtrl.classList.remove('playing');
  }
});
</script>
